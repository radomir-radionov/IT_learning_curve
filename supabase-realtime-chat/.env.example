# Copy to .env and fill in values from:
# https://supabase.com/dashboard/project/_/settings/api

# Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / publishable key (Settings → API → anon public, or publishable key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=your-anon-or-publishable-key

# Secret key for server-side admin client only — never expose to the browser
# (Settings → API → service_role secret, or secret key)
SUPABASE_SECRET_KEY=your-secret-key
